---
import Layout from "@/layouts/Layout.astro";
import NavHeader from "@/components/NavHeader.astro";
import ModelListContent from "@/components/ModelListContent.astro";
---

<Layout lang="th" locale="th_TH">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "AiNaiDee",
      "url": "https://ainaidee.com",
      "description": "ตรวจฮาร์ดแวร์ของคุณและดูว่ารันโมเดล AI ตัวไหนได้บ้าง วิเคราะห์ GPU, CPU และ RAM ในเบราว์เซอร์",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "creator": { "@type": "Person", "name": "midudev", "url": "https://midu.dev" }
    })}></script>
  </Fragment>
  <NavHeader />
  <ModelListContent>
    <header slot="header" class="mb-10 text-center">
      <h1 class="font-pixel text-3xl tracking-tight text-accent sm:text-4xl">
        เครื่องคุณรัน AI ตัวไหนได้บ้าง?
      </h1>
      <p class="mt-2 text-base text-muted">
        ตรวจดูว่าเครื่องของคุณรันโมเดล AI ตัวไหนได้จริง
      </p>
    </header>
  </ModelListContent>
</Layout>
