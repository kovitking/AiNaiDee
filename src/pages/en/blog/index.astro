---
import Layout from "@/layouts/Layout.astro"
import NavHeader from "@/components/NavHeader.astro"
import Footer from "@/components/Footer.astro"
import { getPosts, blogConfigured } from "@/lib/ghost"
import { useTranslations } from "@/i18n/ui"

const posts = await getPosts()
const t = useTranslations("en")

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  })
}

const blogURL = new URL("/en/blog", Astro.site).href
---

<Layout
  title={t("blog.metaTitle")}
  description={t("blog.metaDescription")}
  lang="en"
  locale="en_US"
  hasTranslation={true}
>
  {posts.length > 0 && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": t("blog.jsonLdName"),
        "url": blogURL,
        "blogPost": posts.map((post) => ({
          "@type": "BlogPosting",
          "headline": post.title,
          "url": new URL(`/en/blog/${post.slug}`, Astro.site).href,
          "datePublished": post.published_at,
        })),
      })}></script>
    </Fragment>
  )}
  <NavHeader lang="en" hasTranslation={true} />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="mb-10 text-center">
      <h1 class="font-pixel text-2xl tracking-tight text-accent sm:text-3xl">
        {t("blog.title")}
      </h1>
      <p class="mt-2 text-base text-muted">
        {t("blog.subtitle")}
      </p>
    </header>

    {
      !blogConfigured ? (
        <div class="rounded-lg border border-edge bg-surface-card p-8 text-center">
          <p class="text-base text-secondary">
            {t("blog.notConfiguredPrefix")} <code class="rounded bg-surface px-1 py-0.5 text-primary">GHOST_URL</code>
            {" "}{t("blog.notConfiguredAnd")} <code class="rounded bg-surface px-1 py-0.5 text-primary">GHOST_CONTENT_API_KEY</code>
            {" "}{t("blog.notConfiguredSee")} <code class="rounded bg-surface px-1 py-0.5 text-primary">docs/blog-plan.md</code>
          </p>
        </div>
      ) : posts.length === 0 ? (
        <div class="rounded-lg border border-edge bg-surface-card p-8 text-center">
          <p class="text-base text-secondary">{t("blog.noPosts")}</p>
        </div>
      ) : (
        <div class="space-y-4">
          {posts.map((post) => (
            <a
              href={`/en/blog/${post.slug}`}
              class="block rounded-lg border border-edge bg-surface-card p-5 transition-colors hover:border-accent/40"
            >
              <h2 class="font-pixel text-base text-primary">{post.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {post.excerpt}
              </p>
              <div class="mt-3 flex items-center gap-3 font-mono text-xs text-muted">
                <time datetime={post.published_at}>
                  {formatDate(post.published_at)}
                </time>
                <span>·</span>
                <span>{t("blog.readTime").replace("{mins}", String(post.reading_time))}</span>
              </div>
            </a>
          ))}
        </div>
      )
    }

    <Footer lang="en" />
  </main>
</Layout>
