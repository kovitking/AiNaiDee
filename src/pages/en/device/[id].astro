---
import Layout from "@/layouts/Layout.astro";
import NavHeader from "@/components/NavHeader.astro";
import ModelListContent from "@/components/ModelListContent.astro";
import { getAllDeviceSlugs } from "@/lib/device-slugs";
import { useTranslations } from "@/i18n/ui";
import IconArrowLeft from "@/icons/arrow-left.svg";

export function getStaticPaths() {
  return getAllDeviceSlugs().map((d) => ({
    params: { id: d.slug },
    props: { deviceKey: d.key, deviceName: d.name },
  }));
}

const { deviceKey, deviceName } = Astro.props;
const t = useTranslations("en");

// Derived from `site` in astro.config.mjs (SITE_URL) rather than hardcoded, so
// structured data follows the deployment instead of silently naming another site.
const deviceURL = new URL(`/en/device/${Astro.params.id}`, Astro.site).href;
---

<Layout
  title={t("device.metaTitle").replace("{device}", deviceName)}
  description={t("device.metaDescription").replace("{device}", deviceName)}
  lang="en"
  locale="en_US"
  hasTranslation={true}
  image={`/og/device/${Astro.params.id}.jpg`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": `AiNaiDee — ${deviceName}`,
      "url": deviceURL,
      "description": t("device.jsonLdDescription").replace("{device}", deviceName),
      "inLanguage": "en",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "creator": { "@type": "Organization", "name": "AiNaiDee", "url": new URL("/", Astro.site).href }
    })}></script>
  </Fragment>
  <NavHeader lang="en" hasTranslation={true} />
  <ModelListContent lang="en" deviceKey={deviceKey}>
    <header slot="header" class="mb-10 text-center">
      <a
        href="/en/"
        class="mb-4 inline-flex items-center gap-1.5 font-mono text-[13px] text-muted transition-colors hover:text-primary"
      >
        <IconArrowLeft class="h-3 w-3" />
        {t("device.backToDevices")}
      </a>
      <h1 class="font-pixel text-3xl tracking-tight text-accent sm:text-4xl">
        {deviceName}
      </h1>
      <p class="mt-2 text-base text-muted">
        {t("device.subtitle").replace("{device}", deviceName)}
      </p>
    </header>
  </ModelListContent>
</Layout>
