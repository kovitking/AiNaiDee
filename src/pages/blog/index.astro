---
import Layout from "@/layouts/Layout.astro"
import NavHeader from "@/components/NavHeader.astro"
import Footer from "@/components/Footer.astro"
import { getPosts, blogConfigured } from "@/lib/ghost"

const posts = await getPosts()

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  })
}

const blogURL = new URL("/blog", Astro.site).href
---

<Layout
  title="Blog — AiNaiDee"
  description="Guides and notes on running AI models locally — hardware, quantization, and what actually works."
  lang="en"
  locale="en_US"
>
  {posts.length > 0 && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": "AiNaiDee Blog",
        "url": blogURL,
        "blogPost": posts.map((post) => ({
          "@type": "BlogPosting",
          "headline": post.title,
          "url": new URL(`/blog/${post.slug}`, Astro.site).href,
          "datePublished": post.published_at,
        })),
      })}></script>
    </Fragment>
  )}
  <NavHeader />
  <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="mb-10 text-center">
      <h1 class="font-pixel text-2xl tracking-tight text-accent sm:text-3xl">
        Blog
      </h1>
      <p class="mt-2 text-base text-muted">
        Guides and notes on running AI models locally.
      </p>
    </header>

    {
      !blogConfigured ? (
        <div class="rounded-lg border border-edge bg-surface-card p-8 text-center">
          <p class="text-base text-secondary">
            The blog isn't wired up yet — <code class="rounded bg-surface px-1 py-0.5 text-primary">GHOST_URL</code>
            {" "}and <code class="rounded bg-surface px-1 py-0.5 text-primary">GHOST_CONTENT_API_KEY</code>
            {" "}aren't set. See <code class="rounded bg-surface px-1 py-0.5 text-primary">docs/blog-plan.md</code>.
          </p>
        </div>
      ) : posts.length === 0 ? (
        <div class="rounded-lg border border-edge bg-surface-card p-8 text-center">
          <p class="text-base text-secondary">No posts yet.</p>
        </div>
      ) : (
        <div class="space-y-4">
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="block rounded-lg border border-edge bg-surface-card p-5 transition-colors hover:border-accent/40"
            >
              <h2 class="font-pixel text-base text-primary">{post.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-secondary">
                {post.excerpt}
              </p>
              <div class="mt-3 flex items-center gap-3 font-mono text-xs text-muted">
                <time datetime={post.published_at}>
                  {formatDate(post.published_at)}
                </time>
                <span>·</span>
                <span>{post.reading_time} min read</span>
              </div>
            </a>
          ))}
        </div>
      )
    }

    <Footer />
  </main>
</Layout>
