---
import Logo from "@/icons/logo.svg";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang?: Lang;
  hasTranslation?: boolean;
}

const { lang = (Astro.currentLocale as Lang) ?? "th", hasTranslation = false } = Astro.props;
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const buildDate = new Date();

// `translated` marks routes that have a real file per locale. Only those get a
// locale-prefixed href — everything else still has one language only, so
// pointing an English visitor at /en/compare would 404. Flip the flag when a
// page gains its /en/ counterpart and the nav follows automatically; without
// this the nav would silently drop English visitors back onto Thai pages.
const links = [
  { path: "/models", label: t("nav.models"), translated: true },
  { path: "/playground", label: t("nav.playground"), translated: false },
  { path: "/compare", label: t("nav.compare"), translated: false },
  { path: "/tier", label: t("nav.tier"), translated: false },
  { path: "/docs", label: t("nav.docs"), translated: true },
  { path: "/why", label: t("nav.why"), translated: false },
  // Points at the in-repo /blog route for now. Once Caddy maps
  // blog.ainaidee.com -> app:4321/blog/* (see docs/blog-architecture.md),
  // this should become an absolute link to the subdomain instead.
  { path: "/blog", label: t("nav.blog"), translated: true },
].map(({ path, label, translated }) => ({
  label,
  href: translated
    ? getRelativeLocaleUrl(lang, path.replace(/^\//, ""))
    : path,
  // Compare against the locale-stripped path so the active state still
  // resolves under /en/, where currentPath never equals a bare "/compare".
  path,
}));

const otherLang: Lang = lang === "th" ? "en" : "th";
const pathWithoutLocale = lang === "en"
  ? currentPath.replace(/^\/en\/?/, "/")
  : currentPath;
const switchHref = hasTranslation
  ? getRelativeLocaleUrl(otherLang, pathWithoutLocale.replace(/^\//, ""))
  : null;

// Trailing slashes vary by route ("/why" vs "/why/"), so normalise both sides.
const activePath = pathWithoutLocale.replace(/\/$/, "") || "/";
---

<nav class="border-b border-edge/40">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2.5 sm:px-6">
    <div class="flex items-center gap-2">
      <a href={getRelativeLocaleUrl(lang, "/")} class="flex items-center gap-1 font-pixel text-sm font-bold text-accent transition-colors hover:text-primary">
        <Logo class="size-3" />
        AiNaiDee
      </a>
      <time id="build-time" class="font-mono text-xs text-primary/40" datetime={buildDate.toISOString()} data-lang={lang}>
        updated ...
      </time>
    </div>

    <div class="flex items-center gap-1 sm:gap-4">
      {/* Desktop links */}
      <div class="hidden items-center gap-4 font-mono text-[13px] sm:flex">
        {links.map(({ href, label, path }) => (
          <a
            href={href}
            aria-current={activePath === path ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-accent",
              activePath === path ? "text-primary" : "text-primary/70",
            ]}
          >
            [{label}]
          </a>
        ))}
        {switchHref && (
          <a
            href={switchHref}
            hreflang={otherLang}
            lang={otherLang}
            class="transition-colors text-primary/70 hover:text-accent"
            aria-label={t("nav.switchLangAria")}
          >
            [{t("nav.switchLang")}]
          </a>
        )}
      </div>

      {/* Mobile hamburger */}
      <button
        id="menu-toggle"
        class="flex size-8 items-center justify-center text-primary/70 transition-colors hover:text-accent sm:hidden"
        aria-label={t("nav.openMenu")}
        aria-expanded="false"
      >
        <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="3" y1="5" x2="17" y2="5" />
          <line x1="3" y1="10" x2="17" y2="10" />
          <line x1="3" y1="15" x2="17" y2="15" />
        </svg>
      </button>
    </div>
  </div>
</nav>

{/* Fullscreen mobile menu */}
<div
  id="mobile-menu"
  class="fixed inset-0 z-50 flex flex-col bg-surface transition-all duration-300 ease-out"
  style="opacity:0;visibility:hidden;transform:translateY(-8px)"
  aria-hidden="true"
>
  <div class="flex items-center justify-between px-4 py-2.5">
    <a href={getRelativeLocaleUrl(lang, "/")} class="flex items-center gap-1 font-pixel text-sm text-accent transition-colors hover:text-primary">
      <Logo class="size-3" />
      AiNaiDee
    </a>
    <button
      id="menu-close"
      class="flex size-8 items-center justify-center text-primary/70 transition-colors hover:text-accent"
      aria-label={t("nav.closeMenu")}
    >
      <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="4" y1="4" x2="16" y2="16" />
        <line x1="16" y1="4" x2="4" y2="16" />
      </svg>
    </button>
  </div>

  <div class="flex flex-1 flex-col items-center justify-center gap-6">
    {links.map(({ href, label, path }) => (
      <a
        href={href}
        aria-current={activePath === path ? "page" : undefined}
        class:list={[
          "mobile-menu-link font-mono text-2xl transition-colors hover:text-accent",
          activePath === path ? "text-accent" : "text-primary/70",
        ]}
      >
        [{label}]
      </a>
    ))}
    {switchHref && (
      <a
        href={switchHref}
        hreflang={otherLang}
        lang={otherLang}
        aria-label={t("nav.switchLangAria")}
        class="mobile-menu-link font-mono text-2xl transition-colors text-primary/70 hover:text-accent"
      >
        [{t("nav.switchLang")}]
      </a>
    )}
  </div>

</div>

<script>
  function initNavHeader() {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const close = document.getElementById("menu-close");
    if (!toggle || !menu || !close) return;

    function open() {
      menu!.style.visibility = "visible";
      requestAnimationFrame(() => {
        menu!.style.opacity = "1";
        menu!.style.transform = "translateY(0)";
      });
      toggle!.setAttribute("aria-expanded", "true");
      menu!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function shut() {
      menu!.style.opacity = "0";
      menu!.style.transform = "translateY(-8px)";
      toggle!.setAttribute("aria-expanded", "false");
      menu!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => {
        menu!.style.visibility = "hidden";
      }, 300);
    }

    toggle.addEventListener("click", open);
    close.addEventListener("click", shut);

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", shut);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu!.getAttribute("aria-hidden") === "false") {
        shut();
      }
    });
  }

  const BUILD_TIME_LABELS = {
    th: { just: "เมื่อครู่นี้", min: "นาทีที่แล้ว", hr: "ชม.ที่แล้ว", day: "วันที่แล้ว", updated: "อัปเดต" },
    en: { just: "just now", min: "min ago", hr: "hr ago", day: "days ago", updated: "Updated" },
  };

  function updateBuildTime() {
    const el = document.getElementById("build-time") as HTMLTimeElement | null;
    if (!el) return;

    const buildISO = el.getAttribute("datetime");
    if (!buildISO) return;

    const lang = el.dataset.lang === "en" ? "en" : "th";
    const labels = BUILD_TIME_LABELS[lang];

    const diffMs = Date.now() - new Date(buildISO).getTime();
    const mins = Math.floor(diffMs / 60_000);
    const hours = Math.floor(diffMs / 3_600_000);
    const days = Math.floor(diffMs / 86_400_000);

    let relative: string;
    if (days > 0) relative = `${days} ${labels.day}`;
    else if (hours > 0) relative = `${hours} ${labels.hr}`;
    else if (mins > 0) relative = `${mins} ${labels.min}`;
    else relative = labels.just;

    el.textContent = `${labels.updated} ${relative}`;
  }

  document.addEventListener("astro:page-load", () => {
    updateBuildTime();
    initNavHeader();
  });
</script>
