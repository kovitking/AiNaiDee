---
import Footer from "@/components/Footer.astro"
import {
  models,
  getActiveParamsBillions,
  isCommercialLicense,
  LICENSE_LIST,
} from "@/data/models"
import { getLicenseSlug } from "@/data/licenses"
import hfStats from "@/data/hf-stats.json"
import IconCpu from "@/icons/cpu.svg"
import IconRam from "@/icons/ram.svg"
import IconGpu from "@/icons/gpu.svg"
import IconBandwidth from "@/icons/bandwidth.svg"
import IconSearch from "@/icons/search.svg"
import IconMoe from "@/icons/moe.svg"
import IconTool from "@/icons/tool.svg"
import IconThinking from "@/icons/thinking.svg"
import IconVision from "@/icons/vision.svg"
import IconStar from "@/icons/star.svg"
import { getModelTitleTransitionName } from "@/lib/view-transitions"
import { useTranslations, type Lang } from "@/i18n/ui"
import { useCaseLabel } from "@/i18n/useCases"

interface Props {
  deviceKey?: string
  lang?: Lang
}

const { deviceKey, lang = (Astro.currentLocale as Lang) ?? "th" } = Astro.props
const t = useTranslations(lang)

const hfStatsTyped = hfStats as Record<
  string,
  { downloads: number; likes: number }
>

const sortedModels = [...models].sort(
  (a, b) => a.paramsBillions - b.paramsBillions,
)
const featuredModels = sortedModels.filter((m) => m.featured)
const otherModels = sortedModels.filter((m) => !m.featured)

const providers = [...new Set(models.map((m) => m.provider))].sort()

// Resolved strings the client-side <script> below needs but can't reach
// Astro props for — serialized once here instead of duplicating the
// dictionary import into the client bundle.
const scriptI18n = {
  gradeLabels: {
    S: t("modelList.grades.S"),
    A: t("modelList.grades.A"),
    B: t("modelList.grades.B"),
    C: t("modelList.grades.C"),
    D: t("modelList.grades.D"),
    F: t("modelList.grades.F"),
    unknown: t("modelList.grades.unknown"),
  },
  capacityUnified: t("modelList.capacityUnified"),
  capacityNoGpu: t("modelList.capacityNoGpu"),
  capacityDiscrete: t("modelList.capacityDiscrete"),
  customDevice: t("modelList.customDevice"),
  sysramTooltipApple: t("modelList.sysramTooltipApple"),
  sysramTooltipOther: t("modelList.sysramTooltipOther"),
  webgpuSupported: t("modelList.webgpuSupported"),
  webgpuUnsupported: t("modelList.webgpuUnsupported"),
  verdictOffloadNote: t("modelList.verdictOffloadNote"),
  speedSample: t("modelList.speedSample"),
  speedTiers: {
    fast: t("modelList.speedTiers.fast"),
    smooth: t("modelList.speedTiers.smooth"),
    ok: t("modelList.speedTiers.ok"),
    slow: t("modelList.speedTiers.slow"),
    painful: t("modelList.speedTiers.painful"),
  },
}

function timeAgo(dateStr: string | null): string {
  if (!dateStr) return ""
  const now = new Date()
  const date = new Date(dateStr + "-01")
  const diffMs = now.getTime() - date.getTime()
  const days = Math.floor(diffMs / (1000 * 60 * 60 * 24))
  if (lang === "en") {
    if (days < 0) return "soon"
    if (days === 0) return "today"
    if (days === 1) return "1 day ago"
    if (days < 30) return `${days} days ago`
    const months = Math.floor(days / 30)
    if (months === 1) return "1 month ago"
    if (months < 12) return `${months} months ago`
    const years = Math.floor(months / 12)
    if (years === 1) return "1 year ago"
    return `${years} years ago`
  }
  if (days < 0) return "เร็วๆ นี้"
  if (days === 0) return "วันนี้"
  if (days === 1) return "1 วันที่แล้ว"
  if (days < 30) return `${days} วันที่แล้ว`
  const months = Math.floor(days / 30)
  if (months === 1) return "1 เดือนที่แล้ว"
  if (months < 12) return `${months} เดือนที่แล้ว`
  const years = Math.floor(months / 12)
  if (years === 1) return "1 ปีที่แล้ว"
  return `${years} ปีที่แล้ว`
}

function ctxLabel(n: number): string {
  if (n >= 1_000_000) return `${Math.round(n / 1_000_000)}M`
  if (n >= 1024) return `${Math.round(n / 1024)}K`
  return String(n)
}
---

<main
  id="results"
  class="mx-auto max-w-6xl px-4 pb-20 pt-10 sm:px-6"
  data-device-key={deviceKey}
  data-i18n={JSON.stringify(scriptI18n)}
>
  <!-- Page-specific header -->
  <slot name="header" />

  <!-- Verdict headline — how many models run well on this machine -->
  <section class="mt-8 mb-6">
    <p class="font-mono text-xs uppercase tracking-wide text-muted">
      {t("modelList.verdictEyebrow")}
    </p>
    <h2 class="mt-1 font-pixel text-2xl leading-tight text-primary sm:text-3xl">
      <span id="nd-count" class="font-bold text-accent">—</span> {t("modelList.verdictOf")}
      <span id="nd-total">{models.length}</span> {t("modelList.verdictSuffix")}
    </h2>
    <p id="nd-count-slow" class="mt-1 min-h-[1.2em] text-sm text-secondary"></p>
  </section>

  <!-- Hardware Panel — fixed height to prevent CLS -->
  <section id="hw-panel" class="mb-6 min-h-[52px]">
    <div
      id="hw-bar"
      class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 font-mono text-sm text-secondary"
    >
      <!-- GPU -->
      <span id="hw-gpu" class="inline-flex items-center gap-1.5 text-muted">
        <span
          data-tooltip={t("modelList.gpuTooltip")}
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label={t("modelList.gpuAria")}
          class="inline-flex shrink-0 flex-col items-center gap-1"
        >
          <IconGpu class="h-4 w-4 text-muted" />
          <span
            class="-mt-px text-[8px] uppercase tracking-widest text-muted leading-none"
            >GPU</span
          >
        </span>
        <select id="hw-device-select" class="hw-editable-select" disabled>
          <option value="">{t("modelList.gpuDetecting")}</option>
        </select>
      </span>
      <span class="text-edge/40">|</span>
      <!-- VRAM -->
      <span id="hw-ram" class="inline-flex items-center gap-1.5 text-muted">
        <span
          data-tooltip={t("modelList.vramTooltip")}
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label={t("modelList.vramAria")}
          class="inline-flex shrink-0 flex-col items-center gap-1"
        >
          <IconRam class="h-4 w-4 text-muted" />
          <span
            id="hw-vram-label"
            class="-mt-px text-[8px] uppercase tracking-widest text-muted leading-none"
            >VRAM</span
          >
        </span>
        <select id="hw-ram-select" class="hw-editable-select" disabled>
          <option value="">—</option>
        </select>
      </span>
      <!-- Bandwidth -->
      <span id="hw-bw" class="hidden inline-flex items-center gap-1.5">
        <span class="text-edge/40">|</span>
        <span
          data-tooltip={t("modelList.bandwidthTooltip")}
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label={t("modelList.bandwidthAria")}
          class="inline-flex shrink-0 flex-col items-center gap-1"
        >
          <IconBandwidth class="h-4 w-4 text-muted" />
          <span
            class="-mt-px text-[8px] uppercase tracking-widest text-muted leading-none"
            >BW</span
          >
        </span>
        <select id="hw-bw-select" class="hw-editable-select"></select>
      </span>
      <!-- System RAM -->
      <span id="hw-sysram" class="hidden inline-flex items-center gap-1.5">
        <span class="text-edge/40">|</span>
        <span
          data-tooltip={t("modelList.sysramTooltip")}
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label={t("modelList.sysramAria")}
          class="inline-flex shrink-0 flex-col items-center gap-1"
        >
          <IconRam class="h-4 w-4 text-muted" />
          <span
            class="-mt-px text-[8px] uppercase tracking-widest text-muted leading-none"
            >RAM</span
          >
        </span>
        <select id="hw-sysram-select" class="hw-editable-select"></select>
      </span>
      <!-- GPU Cores -->
      <span id="hw-gpu-cores" class="hidden inline-flex items-center gap-1.5">
        <span class="text-edge/40">|</span>
        <span
          data-tooltip={t("modelList.gpuCoresTooltip")}
          data-tooltip-pos="bottom"
          tabindex="0"
          aria-label={t("modelList.gpuCoresAria")}
          class="inline-flex shrink-0 flex-col items-center gap-1"
        >
          <IconCpu class="h-4 w-4 text-muted" />
          <span
            class="-mt-px text-[8px] uppercase tracking-widest text-muted leading-none"
            >CORES</span
          >
        </span>
        <span id="hw-gpu-cores-text" class="text-secondary"></span>
      </span>
    </div>
    <p
      id="hw-notice"
      class="mt-1.5 flex items-center justify-center gap-2 text-center text-xs text-muted invisible"
    >
      <span>{t("modelList.hwNotice")}</span>
      <span
        id="hw-webgpu-badge"
        class="inline-flex items-center gap-1 rounded-full border px-1.5 py-px text-[10px] font-medium"
        data-tooltip-pos="bottom"
        tabindex="0"></span>
    </p>
  </section>

  <!-- Summary counters — grade distribution -->
  <div id="summary-bar" class="mb-8 invisible">
    <div
      class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-mono text-xs sm:text-[13px] sm:gap-x-4"
    >
      <span
        class="flex items-center gap-1.5"
        style="color: var(--color-can-run)"
        data-tooltip={t("modelList.gradeTooltips.S")}
        tabindex="0"
        role="group"
        aria-label={`${t("modelList.gradeWord")} S: ${t("modelList.grades.S")}`}
      >
        <span id="count-s" class="font-bold text-sm sm:text-base">0</span>
        <span class="font-medium uppercase tracking-wide">{t("modelList.grades.S")}</span>
      </span>
      <span class="h-3 w-px bg-edge/40"></span>
      <span
        class="flex items-center gap-1.5"
        style="color: var(--color-grade-a)"
        data-tooltip={t("modelList.gradeTooltips.A")}
        tabindex="0"
        role="group"
        aria-label={`${t("modelList.gradeWord")} A: ${t("modelList.grades.A")}`}
      >
        <span id="count-a" class="font-bold text-sm sm:text-base">0</span>
        <span class="font-medium uppercase tracking-wide">{t("modelList.grades.A")}</span>
      </span>
      <span class="h-3 w-px bg-edge/40"></span>
      <span
        class="flex items-center gap-1.5"
        style="color: var(--color-grade-b)"
        data-tooltip={t("modelList.gradeTooltips.B")}
        tabindex="0"
        role="group"
        aria-label={`${t("modelList.gradeWord")} B: ${t("modelList.grades.B")}`}
      >
        <span id="count-b" class="font-bold text-sm sm:text-base">0</span>
        <span class="font-medium uppercase tracking-wide">{t("modelList.grades.B")}</span>
      </span>
      <span class="h-3 w-px bg-edge/40"></span>
      <span
        class="flex items-center gap-1.5"
        style="color: var(--color-maybe)"
        data-tooltip={t("modelList.gradeTooltips.C")}
        tabindex="0"
        role="group"
        aria-label={`${t("modelList.gradeWord")} C: ${t("modelList.grades.C")}`}
      >
        <span id="count-c" class="font-bold text-sm sm:text-base">0</span>
        <span class="font-medium uppercase tracking-wide">{t("modelList.grades.C")}</span>
      </span>
      <span class="h-3 w-px bg-edge/40"></span>
      <span
        class="flex items-center gap-1.5"
        style="color: var(--color-grade-d)"
        data-tooltip={t("modelList.gradeTooltips.D")}
        tabindex="0"
        role="group"
        aria-label={`${t("modelList.gradeWord")} D: ${t("modelList.grades.D")}`}
      >
        <span id="count-d" class="font-bold text-sm sm:text-base">0</span>
        <span class="font-medium uppercase tracking-wide">{t("modelList.grades.D")}</span>
      </span>
      <span class="h-3 w-px bg-edge/40"></span>
      <span
        class="flex items-center gap-1.5"
        style="color: var(--color-cannot-run)"
        data-tooltip={t("modelList.gradeTooltips.F")}
        tabindex="0"
        role="group"
        aria-label={`${t("modelList.gradeWord")} F: ${t("modelList.grades.F")}`}
      >
        <span id="count-f" class="font-bold text-sm sm:text-base">0</span>
        <span class="font-medium uppercase tracking-wide">{t("modelList.grades.F")}</span>
      </span>
    </div>
  </div>

  <!-- Search + Filters bar (single line) -->
  <div class="mb-6 flex flex-wrap items-center gap-2">
    <!-- Search -->
    <div class="relative flex-1 min-w-[180px] max-w-xs">
      <IconSearch
        class="pointer-events-none absolute left-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-muted"
      />
      <input
        id="search-input"
        type="text"
        placeholder={t("modelList.searchPlaceholder")}
        class="filter-select w-full !pl-8 pr-8"
        autocomplete="off"
      />
      <kbd
        class="pointer-events-none absolute right-2 top-1/2 hidden -translate-y-1/2 rounded border border-edge/60 bg-surface-raised px-1.5 py-0.5 font-mono text-xs leading-none text-secondary shadow-[0_1px_0_0_var(--color-edge)] sm:inline-block"
        >/</kbd
      >
    </div>

    <span class="hidden h-4 w-px bg-edge/40 sm:block"></span>

    <!-- Status filter -->
    <select id="filter-status" class="filter-select">
      <option value="all">{t("modelList.filterStatusAll")}</option>
      <option value="featured">{t("modelList.filterStatusFeatured")}</option>
      <option value="can-run">{t("modelList.filterStatusCanRun")}</option>
      <option value="tight">{t("modelList.filterStatusTight")}</option>
      <option value="cannot-run">{t("modelList.filterStatusCannotRun")}</option>
    </select>

    <!-- Use case filter -->
    <select id="filter-use" class="filter-select">
      <option value="all">{t("modelList.filterUseAll")}</option>
      <option value="chat">{useCaseLabel(["chat"], lang)}</option>
      <option value="code">{useCaseLabel(["code"], lang)}</option>
      <option value="reasoning">{useCaseLabel(["reasoning"], lang)}</option>
      <option value="vision">{useCaseLabel(["vision"], lang)}</option>
    </select>

    <!-- Provider filter -->
    <select id="filter-provider" class="filter-select">
      <option value="all">{t("modelList.filterProviderAll")}</option>
      {providers.map((p) => <option value={p}>{p}</option>)}
    </select>

    <!-- License filter -->
    <select id="filter-license" class="filter-select">
      <option value="all">{t("modelList.filterLicenseAll")}</option>
      <option value="commercial">{t("modelList.filterLicenseCommercial")}</option>
      <option value="non-commercial">{t("modelList.filterLicenseNonCommercial")}</option>
      {LICENSE_LIST.map((l) => <option value={l}>{l}</option>)}
    </select>

    <!-- Sort -->
    <select id="sort-select" class="filter-select">
      <option value="score">{t("modelList.sortScore")}</option>
      <option value="params-asc">{t("modelList.sortParamsAsc")}</option>
      <option value="params-desc">{t("modelList.sortParamsDesc")}</option>
      <option value="release">{t("modelList.sortRelease")}</option>
      <option value="context">{t("modelList.sortContext")}</option>
      <option value="toks">{t("modelList.sortToks")}</option>
      <option value="vram">{t("modelList.sortVram")}</option>
      <option value="downloads">{t("modelList.sortDownloads")}</option>
    </select>
  </div>

  <!-- Ruler section: the shared scale + "your machine" capacity row + model rows -->
  <section id="model-ruler" aria-label="Compare model size against your machine's capacity">
    <div class="nd-scale" aria-hidden="true">
      <span></span>
      <div class="nd-scale-track">
        <span class="nd-scale-tick" style="--at: 0%" data-ruler-tick>0</span>
        <span class="nd-scale-tick" style="--at: 25%" data-ruler-tick></span>
        <span class="nd-scale-tick" style="--at: 50%" data-ruler-tick></span>
        <span class="nd-scale-tick" style="--at: 75%" data-ruler-tick></span>
        <span class="nd-scale-tick nd-scale-tick-end" style="--at: 100%" data-ruler-tick></span>
      </div>
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="nd-row nd-row-you">
      <div class="nd-row-grade"></div>
      <div class="nd-row-name">
        <span class="nd-row-title">{t("modelList.yourMachine")}</span>
        <span class="nd-row-meta" id="nd-cap-meta">{t("modelList.detectingHardware")}</span>
      </div>
      <div class="nd-track nd-track-you">
        <div class="nd-bar nd-bar-you" id="nd-cap-bar"></div>
        <span class="nd-limit-tag" id="nd-limit-tag"></span>
      </div>
      <div class="nd-row-num"></div>
      <div class="nd-row-speed"></div>
      <div class="nd-row-chip"></div>
    </div>

    <p class="nd-help">
      {t("modelList.rulerHelp1")}
      {t("modelList.rulerHelp2")}
    </p>

    <!-- Popular models -->
    <div id="models-grid" class="nd-list">
      {
        featuredModels.map((model) => (
          <a href={`/model/${model.id}`} class="nd-row-link block">
            <div
              data-model-id={model.id}
              data-model-name={model.name}
              data-quants={JSON.stringify(model.quants)}
              data-params={model.paramsBillions}
              data-active-params={getActiveParamsBillions(model)}
              data-arch={model.architecture}
              data-uses={model.useCase.join(",")}
              data-provider={model.provider}
              data-context={model.contextLength}
              data-release={model.releaseDate || ""}
              data-featured="true"
              data-license={model.license || ""}
              data-commercial={
                isCommercialLicense(model.license) ? "true" : "false"
              }
              data-downloads={hfStatsTyped[model.id]?.downloads || 0}
              class="nd-row"
            >
              <div class="nd-row-grade">
                <span data-grade-badge class="nd-grade" />
              </div>

              <div class="nd-row-name">
                <span
                  class="nd-row-title"
                  style={`view-transition-name: ${getModelTitleTransitionName(model.id)};`}
                >
                  {model.name}
                  <span data-badges class="inline-flex items-center gap-1">
                    {model.architecture === "moe" && (
                      <i class="nd-tag" title="Mixture of Experts">
                        <IconMoe class="h-2.5 w-2.5" />
                      </i>
                    )}
                    {model.tools && (
                      <i class="nd-tag" title={t("modelList.tagTool")}>
                        <IconTool class="h-2.5 w-2.5" />
                      </i>
                    )}
                    {model.thinking && (
                      <i class="nd-tag" title={t("modelList.tagThinking")}>
                        <IconThinking class="h-2.5 w-2.5" />
                      </i>
                    )}
                    {model.useCase.includes("vision") && (
                      <i class="nd-tag" title={t("modelList.tagVision")}>
                        <IconVision class="h-2.5 w-2.5" />
                      </i>
                    )}
                    <i class="nd-tag nd-tag-star" title={t("modelList.tagFeatured")}>
                      <IconStar class="h-2.5 w-2.5" />
                    </i>
                  </span>
                </span>
                <span class="nd-row-meta">
                  {model.provider} · {model.params}
                  {model.architecture === "moe"
                    ? ` (active ${getActiveParamsBillions(model).toFixed(0)}B)`
                    : ""}{" "}
                  · {useCaseLabel(model.useCase, lang)} · ctx {ctxLabel(model.contextLength)} ·{" "}
                  {model.architecture === "moe" ? "MoE" : "Dense"}
                  {model.license && (
                    <>
                      {" "}
                      ·{" "}
                      <span
                        data-license-link={`/license/${getLicenseSlug(model.license)}`}
                        class="nd-license-link"
                      >
                        {model.license}
                      </span>
                    </>
                  )}
                  {model.releaseDate ? ` · ${timeAgo(model.releaseDate)}` : ""}
                  <span data-mem-pct />
                </span>
                <div class="nd-quants">
                  {model.quants.map((q, i) => (
                    <button
                      type="button"
                      data-quant-btn={i}
                      class:list={["nd-quant-btn", { "is-active": i === 2 }]}
                    >
                      {q.name}
                    </button>
                  ))}
                </div>
              </div>

              <div class="nd-track">
                <div class="nd-bar" data-vram-bar />
                <span class="nd-over" data-over hidden>▶</span>
              </div>

              <div class="nd-row-num" data-vram-val />
              <div class="nd-row-speed" data-tok-speed />
              <div class="nd-row-chip">
                <span data-status-badge class="nd-status" />
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Section divider -->
    <div id="rest-divider" class="my-8 flex items-center gap-4">
      <div class="h-px flex-1 bg-edge/30"></div>
      <span class="font-mono text-[13px] text-muted/60">{t("modelList.allModelsDivider")}</span>
      <div class="h-px flex-1 bg-edge/30"></div>
    </div>

    <!-- Rest of models -->
    <div id="models-grid-rest" class="nd-list">
      {
        otherModels.map((model) => (
          <a href={`/model/${model.id}`} class="nd-row-link block">
            <div
              data-model-id={model.id}
              data-model-name={model.name}
              data-quants={JSON.stringify(model.quants)}
              data-params={model.paramsBillions}
              data-active-params={getActiveParamsBillions(model)}
              data-arch={model.architecture}
              data-uses={model.useCase.join(",")}
              data-provider={model.provider}
              data-context={model.contextLength}
              data-release={model.releaseDate || ""}
              data-license={model.license || ""}
              data-commercial={
                isCommercialLicense(model.license) ? "true" : "false"
              }
              data-downloads={hfStatsTyped[model.id]?.downloads || 0}
              class="nd-row"
            >
              <div class="nd-row-grade">
                <span data-grade-badge class="nd-grade" />
              </div>

              <div class="nd-row-name">
                <span
                  class="nd-row-title"
                  style={`view-transition-name: ${getModelTitleTransitionName(model.id)};`}
                >
                  {model.name}
                  <span data-badges class="inline-flex items-center gap-1">
                    {model.architecture === "moe" && (
                      <i class="nd-tag" title="Mixture of Experts">
                        <IconMoe class="h-2.5 w-2.5" />
                      </i>
                    )}
                    {model.tools && (
                      <i class="nd-tag" title={t("modelList.tagTool")}>
                        <IconTool class="h-2.5 w-2.5" />
                      </i>
                    )}
                    {model.thinking && (
                      <i class="nd-tag" title={t("modelList.tagThinking")}>
                        <IconThinking class="h-2.5 w-2.5" />
                      </i>
                    )}
                    {model.useCase.includes("vision") && (
                      <i class="nd-tag" title={t("modelList.tagVision")}>
                        <IconVision class="h-2.5 w-2.5" />
                      </i>
                    )}
                  </span>
                </span>
                <span class="nd-row-meta">
                  {model.provider} · {model.params}
                  {model.architecture === "moe"
                    ? ` (active ${getActiveParamsBillions(model).toFixed(0)}B)`
                    : ""}{" "}
                  · {useCaseLabel(model.useCase, lang)} · ctx {ctxLabel(model.contextLength)} ·{" "}
                  {model.architecture === "moe" ? "MoE" : "Dense"}
                  {model.license && (
                    <>
                      {" "}
                      ·{" "}
                      <span
                        data-license-link={`/license/${getLicenseSlug(model.license)}`}
                        class="nd-license-link"
                      >
                        {model.license}
                      </span>
                    </>
                  )}
                  {model.releaseDate ? ` · ${timeAgo(model.releaseDate)}` : ""}
                  <span data-mem-pct />
                </span>
                <div class="nd-quants">
                  {model.quants.map((q, i) => (
                    <button
                      type="button"
                      data-quant-btn={i}
                      class:list={["nd-quant-btn", { "is-active": i === 2 }]}
                    >
                      {q.name}
                    </button>
                  ))}
                </div>
              </div>

              <div class="nd-track">
                <div class="nd-bar" data-vram-bar />
                <span class="nd-over" data-over hidden>▶</span>
              </div>

              <div class="nd-row-num" data-vram-val />
              <div class="nd-row-speed" data-tok-speed />
              <div class="nd-row-chip">
                <span data-status-badge class="nd-status" />
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- No results empty state -->
    <div id="no-results" class="hidden py-20 text-center">
      <p class="font-pixel text-lg text-muted/60">{t("modelList.noResultsTitle")}</p>
      <p class="mt-2 text-base text-muted/40">
        {t("modelList.noResultsBody")}
      </p>
      <button
        id="reset-filters"
        class="mt-5 inline-flex items-center gap-1.5 rounded-lg border border-edge/60 bg-surface-raised px-4 py-2 font-mono text-sm text-secondary transition-colors hover:border-accent/30 hover:bg-surface-hover hover:text-primary cursor-pointer"
      >
        {t("modelList.resetFilters")}
      </button>
    </div>
  </section>

  <Footer class="mt-20" lang={lang}>
    <p class="text-[13px] text-muted/70">
      {t("footer.dataCreditPrefix")} <a
        href="https://github.com/ggerganov/llama.cpp"
        target="_blank"
        rel="noopener"
        class="text-muted underline decoration-edge underline-offset-2 hover:text-primary"
        >llama.cpp</a
      >, <a
        href="https://ollama.com"
        target="_blank"
        rel="noopener"
        class="text-muted underline decoration-edge underline-offset-2 hover:text-primary"
        >Ollama</a
      > {t("footer.and")} <a
        href="https://lmstudio.ai"
        target="_blank"
        rel="noopener"
        class="text-muted underline decoration-edge underline-offset-2 hover:text-primary"
        >LM Studio</a
      >
    </p>
  </Footer>
</main>

<script>
  import {
    detectHardware,
    evaluateModelComplete,
    getDisplayName,
    getHardwareOverrides,
    saveHardwareOverrides,
    applyOverrides,
    getDeviceOverrides,
    RAM_OPTIONS,
    BW_OPTIONS,
  } from "@/lib/hardware"
  import type {
    HardwareInfo,
    ModelStatus,
    Grade,
    GradeInfo,
  } from "@/lib/hardware"
  import {
    fitSelectWidth,
    populateSelect,
    appendDeviceOptgroups,
  } from "@/lib/hardware-ui"
  import { deviceKeyToSlug, slugToDeviceKey } from "@/lib/device-slugs"

  interface ScriptI18n {
    gradeLabels: { S: string; A: string; B: string; C: string; D: string; F: string; unknown: string }
    capacityUnified: string
    capacityNoGpu: string
    capacityDiscrete: string
    customDevice: string
    sysramTooltipApple: string
    sysramTooltipOther: string
    webgpuSupported: string
    webgpuUnsupported: string
    verdictOffloadNote: string
    speedSample: string
    speedTiers: { fast: string; smooth: string; ok: string; slow: string; painful: string }
  }

  // Recomputed on every "astro:page-load" (see Boot section below), not just
  // once at module init — this script module persists across Astro's
  // client-side view transitions, so a stale I18N/GRADES here would keep
  // showing the previous page's language after navigating between / and /en/.
  let I18N: ScriptI18n = {} as ScriptI18n
  let GRADES: Record<Grade, GradeInfo> = {} as Record<Grade, GradeInfo>

  function loadI18n() {
    I18N = JSON.parse(document.getElementById("results")?.dataset.i18n || "{}")
    GRADES = {
      S: { letter: "S", label: I18N.gradeLabels.S, color: "var(--color-can-run)" },
      A: { letter: "A", label: I18N.gradeLabels.A, color: "var(--color-grade-a)" },
      B: { letter: "B", label: I18N.gradeLabels.B, color: "var(--color-grade-b)" },
      C: { letter: "C", label: I18N.gradeLabels.C, color: "var(--color-maybe)" },
      D: { letter: "D", label: I18N.gradeLabels.D, color: "var(--color-grade-d)" },
      F: { letter: "F", label: I18N.gradeLabels.F, color: "var(--color-cannot-run)" },
      "?": { letter: "?", label: I18N.gradeLabels.unknown, color: "var(--color-muted)" },
    }
  }

  function fillTemplate(template: string, values: Record<string, string | number>): string {
    return template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ""))
  }

  const $ = <T extends Element = HTMLElement>(s: string) =>
    document.querySelector<T>(s)
  const $$ = <T extends Element = HTMLElement>(s: string) => [
    ...document.querySelectorAll<T>(s),
  ]

  // ── URL / Query Param Helpers ─────────────────────────────

  function buildFilterQueryString(): URLSearchParams {
    const params = new URLSearchParams()
    if (searchQuery) params.set("q", searchQuery)
    if (activeStatusFilter !== "all") params.set("status", activeStatusFilter)
    if (activeUseFilter !== "all") params.set("use", activeUseFilter)
    if (activeProviderFilter !== "all")
      params.set("provider", activeProviderFilter)
    if (activeLicenseFilter !== "all")
      params.set("license", activeLicenseFilter)
    if (currentSort !== "score") params.set("sort", currentSort)
    return params
  }

  function syncFiltersToURL() {
    const params = buildFilterQueryString()
    const qs = params.toString() ? `?${params.toString()}` : ""
    const path = window.location.pathname
    history.replaceState({}, "", `${path}${qs}`)
  }

  function readFiltersFromURL() {
    const params = new URLSearchParams(window.location.search)
    searchQuery = params.get("q") || ""
    activeStatusFilter = params.get("status") || "all"
    activeUseFilter = params.get("use") || "all"
    activeProviderFilter = params.get("provider") || "all"
    activeLicenseFilter = params.get("license") || "all"
    const sortParam = params.get("sort")
    if (sortParam) currentSort = sortParam

    const searchInput = $<HTMLInputElement>("#search-input")
    const statusSelect = $<HTMLSelectElement>("#filter-status")
    const useSelect = $<HTMLSelectElement>("#filter-use")
    const providerSelect = $<HTMLSelectElement>("#filter-provider")
    const licenseSelect = $<HTMLSelectElement>("#filter-license")
    const sortSelect = $<HTMLSelectElement>("#sort-select")

    if (searchInput) searchInput.value = searchQuery
    if (statusSelect) statusSelect.value = activeStatusFilter
    if (useSelect) useSelect.value = activeUseFilter
    if (providerSelect) providerSelect.value = activeProviderFilter
    if (licenseSelect) licenseSelect.value = activeLicenseFilter
    if (sortSelect) sortSelect.value = currentSort
  }

  // ── Main Logic ─────────────────────────────────────────────

  let detectedHW: HardwareInfo
  let currentHW: HardwareInfo
  let currentUsable = 0
  let currentRulerMax = 48

  // The ruler's scale adapts to the machine: consumer GPUs stay legible
  // instead of every row past ~48GB collapsing into the overflow arrow.
  function rulerMaxFor(usableGB: number): number {
    const raw = usableGB > 0 ? usableGB * 2.5 : 48
    return Math.max(24, Math.ceil(raw / 8) * 8)
  }

  function usableCapacity(hw: HardwareInfo): number {
    if (hw.isAppleSilicon) {
      return hw.totalUsableRAM ?? Math.round((hw.ramGB ?? 0) * 0.75)
    }
    return hw.estimatedVRAM ?? 0
  }

  function capacityMetaText(hw: HardwareInfo, usable: number): string {
    if (hw.isAppleSilicon) {
      return fillTemplate(I18N.capacityUnified, {
        ram: hw.ramGB ?? hw.totalUsableRAM ?? "—",
        usable,
      })
    }
    if (!hw.estimatedVRAM) {
      return fillTemplate(I18N.capacityNoGpu, {
        ram: hw.systemRAM ?? hw.ramGB ?? "—",
      })
    }
    return fillTemplate(I18N.capacityDiscrete, {
      usable,
      ram: hw.systemRAM ?? hw.ramGB ?? "—",
    })
  }

  function updateRulerTicks(rulerMax: number) {
    const ticks = $$("[data-ruler-tick]")
    const fractions = [0, 0.25, 0.5, 0.75, 1]
    ticks.forEach((tick, i) => {
      const frac = fractions[i]
      if (frac === undefined) return
      const val = Math.round(rulerMax * frac)
      tick.textContent = frac === 1 ? `${val} GB` : String(val)
    })
  }

  function populateDeviceSelect(
    select: HTMLSelectElement,
    detectedName: string,
    storedDevice: string | undefined,
  ) {
    select.innerHTML = ""

    const autoOpt = document.createElement("option")
    autoOpt.value = "auto"
    autoOpt.textContent = `${detectedName} ✱`
    select.appendChild(autoOpt)

    const customOpt = document.createElement("option")
    customOpt.value = "custom"
    customOpt.textContent = I18N.customDevice
    select.appendChild(customOpt)

    appendDeviceOptgroups(select, storedDevice)

    select.value = storedDevice || "auto"
    select.disabled = false
    fitSelectWidth(select)
  }

  function updateHardwarePanel(hw: HardwareInfo) {
    const overrides = getHardwareOverrides()

    const deviceSelect = $<HTMLSelectElement>("#hw-device-select")
    if (deviceSelect) {
      populateDeviceSelect(
        deviceSelect,
        getDisplayName(detectedHW),
        overrides.device,
      )
    }
    $("#hw-gpu")!.classList.replace("text-muted", "text-secondary")

    const effectiveRam = hw.ramGB ?? hw.totalUsableRAM
    const ramSelect = $<HTMLSelectElement>("#hw-ram-select")
    if (ramSelect && effectiveRam) {
      populateSelect(
        ramSelect,
        RAM_OPTIONS,
        detectedHW.ramGB,
        overrides.ramGB ?? effectiveRam,
        (v) => `${v} GB`,
      )
      ramSelect.disabled = false
    }
    $("#hw-ram")!.classList.replace("text-muted", "text-secondary")

    const vramLabel = $("#hw-vram-label")
    if (vramLabel) vramLabel.textContent = "VRAM"

    const sysramContainer = $("#hw-sysram")
    const sysramSelect = $<HTMLSelectElement>("#hw-sysram-select")
    const sysramTooltip = sysramContainer?.querySelector(
      "[data-tooltip]",
    ) as HTMLElement | null
    if (sysramContainer && sysramSelect) {
      if (hw.isMobile) {
        sysramContainer.classList.add("hidden")
      } else if (hw.isAppleSilicon) {
        sysramContainer.classList.remove("hidden")
        sysramSelect.innerHTML = ""
        const opt = document.createElement("option")
        opt.value = ""
        opt.textContent = `${hw.totalUsableRAM ?? "—"} GB`
        sysramSelect.appendChild(opt)
        sysramSelect.disabled = true
        sysramSelect.classList.add("opacity-50", "cursor-not-allowed")
        fitSelectWidth(sysramSelect)
        if (sysramTooltip) {
          sysramTooltip.setAttribute("data-tooltip", I18N.sysramTooltipApple)
        }
      } else {
        sysramContainer.classList.remove("hidden")
        sysramSelect.disabled = false
        sysramSelect.classList.remove("opacity-50", "cursor-not-allowed")
        const raw = detectedHW.deviceMemoryRaw
        const isGte8 = raw === null || raw >= 8
        const selected = overrides.systemRAM ?? hw.systemRAM ?? 16

        sysramSelect.innerHTML = ""
        const optGte8 = document.createElement("option")
        optGte8.value = "16"
        optGte8.textContent = isGte8 ? "≥8 GB ✱" : "≥8 GB"
        sysramSelect.appendChild(optGte8)

        const optLt8 = document.createElement("option")
        optLt8.value = "4"
        optLt8.textContent = !isGte8 ? "<8 GB ✱" : "<8 GB"
        sysramSelect.appendChild(optLt8)

        const sep = document.createElement("option")
        sep.disabled = true
        sep.textContent = "───"
        sysramSelect.appendChild(sep)

        for (const v of [8, 16, 32, 64, 128]) {
          const opt = document.createElement("option")
          opt.value = String(v)
          opt.textContent = `${v} GB`
          sysramSelect.appendChild(opt)
        }

        sysramSelect.value = String(selected)
        fitSelectWidth(sysramSelect)
        if (sysramTooltip) {
          sysramTooltip.setAttribute("data-tooltip", I18N.sysramTooltipOther)
        }
      }
    }

    const effectiveBw = hw.memoryBandwidth
    if (effectiveBw) {
      $("#hw-bw")!.classList.remove("hidden")
      const bwSelect = $<HTMLSelectElement>("#hw-bw-select")
      if (bwSelect) {
        populateSelect(
          bwSelect,
          BW_OPTIONS,
          detectedHW.memoryBandwidth,
          overrides.memoryBandwidth ?? effectiveBw,
          (v) => `~${v} GB/s`,
        )
      }
    } else {
      $("#hw-bw")!.classList.add("hidden")
    }

    if (hw.gpuCores) {
      $("#hw-gpu-cores")!.classList.remove("hidden")
      $("#hw-gpu-cores-text")!.textContent = `${hw.gpuCores.toLocaleString()}`
    } else {
      $("#hw-gpu-cores")!.classList.add("hidden")
    }

    $("#hw-notice")!.classList.remove("invisible")

    const webgpuBadge = $("#hw-webgpu-badge")!
    if (hw.webgpu) {
      webgpuBadge.className =
        "inline-flex items-center gap-1 rounded-full border border-accent/30 bg-accent/10 px-1.5 py-px text-[10px] font-medium text-accent"
      webgpuBadge.setAttribute("data-tooltip", I18N.webgpuSupported)
      webgpuBadge.innerHTML = `<svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>WebGPU</span>`
    } else {
      webgpuBadge.className =
        "inline-flex items-center gap-1 rounded-full border border-cannot-run/30 bg-cannot-run/10 px-1.5 py-px text-[10px] font-medium text-cannot-run"
      webgpuBadge.setAttribute("data-tooltip", I18N.webgpuUnsupported)
      webgpuBadge.innerHTML = `<svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg><span>WebGPU</span>`
    }

    const usable = usableCapacity(hw)
    currentUsable = usable
    const rulerMax = rulerMaxFor(usable)
    currentRulerMax = rulerMax
    updateRulerTicks(rulerMax)

    const limitPct = Math.min(usable / rulerMax, 1) * 100
    const ruler = $("#model-ruler")
    if (ruler) ruler.style.setProperty("--limit", `${limitPct}%`)
    const capBar = $("#nd-cap-bar")
    if (capBar) capBar.style.width = `${limitPct}%`
    const limitTag = $("#nd-limit-tag")
    if (limitTag) limitTag.textContent = `${usable} GB`
    const capMeta = $("#nd-cap-meta")
    if (capMeta) capMeta.textContent = capacityMetaText(hw, usable)
  }

  function handleDeviceChange(deviceKey: string) {
    if (deviceKey === "custom") {
      const prev = getHardwareOverrides()
      prev.device = "custom"
      saveHardwareOverrides(prev)
      return
    }

    const params = buildFilterQueryString()
    const qs = params.toString() ? `?${params.toString()}` : ""

    if (deviceKey === "auto") {
      saveHardwareOverrides({})
      currentHW = { ...detectedHW }
      updateHardwarePanel(currentHW)
      updateAllRows(currentHW)
      history.pushState({}, "", `/${qs}`)
      return
    }

    const deviceOverrides = getDeviceOverrides(deviceKey)
    if (!deviceOverrides) return

    const prev = getHardwareOverrides()
    if (prev.systemRAM !== undefined) deviceOverrides.systemRAM = prev.systemRAM

    saveHardwareOverrides(deviceOverrides)
    currentHW = applyOverrides(detectedHW, deviceOverrides)
    updateHardwarePanel(currentHW)
    updateAllRows(currentHW)

    const slug = deviceKeyToSlug(deviceKey)
    history.pushState({}, "", `/device/${slug}${qs}`)
  }

  function setupHardwareEditing() {
    const deviceSelect = $<HTMLSelectElement>("#hw-device-select")
    const ramSelect = $<HTMLSelectElement>("#hw-ram-select")
    const sysramSelect = $<HTMLSelectElement>("#hw-sysram-select")
    const bwSelect = $<HTMLSelectElement>("#hw-bw-select")

    deviceSelect?.addEventListener("change", () => {
      handleDeviceChange(deviceSelect.value)
    })

    function handleFieldChange() {
      const overrides = getHardwareOverrides()
      if (ramSelect?.value) overrides.ramGB = Number(ramSelect.value)
      if (sysramSelect?.value) overrides.systemRAM = Number(sysramSelect.value)
      if (bwSelect?.value) overrides.memoryBandwidth = Number(bwSelect.value)
      if (!overrides.device || overrides.device === "auto") {
        overrides.device = "custom"
        const ds = $<HTMLSelectElement>("#hw-device-select")
        if (ds) {
          ds.value = "custom"
          fitSelectWidth(ds)
        }
      }
      saveHardwareOverrides(overrides)
      currentHW = applyOverrides(detectedHW, overrides)
      updateAllRows(currentHW)
    }

    ramSelect?.addEventListener("change", () => {
      handleFieldChange()
      fitSelectWidth(ramSelect)
    })
    sysramSelect?.addEventListener("change", () => {
      handleFieldChange()
      fitSelectWidth(sysramSelect)
    })
    bwSelect?.addEventListener("change", () => {
      handleFieldChange()
      fitSelectWidth(bwSelect)
    })
  }

  function updateModelRow(
    row: HTMLElement,
    hw: HardwareInfo,
    quantIndex: number = 2,
  ) {
    const quants = JSON.parse(row.dataset.quants || "[]")
    const quant = quants[quantIndex] || quants[0]
    if (!quant) return

    const vram = quant.vramGB
    const params = parseFloat(row.dataset.params || "0")
    const activeParams = parseFloat(row.dataset.activeParams || "0")
    const {
      status,
      toksPerSec: toks,
      memPct,
      score,
      grade,
    } = evaluateModelComplete(vram, hw, params, {
      activeParamsBillions: activeParams,
    })
    const gradeInfo = GRADES[grade as Grade]

    row.dataset.grade = grade
    row.dataset.status = status
    row.dataset.score = String(score)
    row.dataset.selectedQuant = String(quantIndex)

    const gradeBadge = row.querySelector<HTMLElement>("[data-grade-badge]")
    if (gradeBadge) {
      gradeBadge.textContent = grade
      gradeBadge.style.background = gradeInfo.color
      gradeBadge.style.color =
        grade === "F" ? "var(--color-primary)" : "var(--color-surface)"
    }

    const statusBadge = row.querySelector<HTMLElement>("[data-status-badge]")
    if (statusBadge) {
      statusBadge.textContent = gradeInfo.label
      statusBadge.style.color = gradeInfo.color
    }

    const pct = Math.min(vram / currentRulerMax, 1) * 100
    const bar = row.querySelector<HTMLElement>("[data-vram-bar]")
    if (bar) bar.style.width = `${pct}%`
    const overMark = row.querySelector<HTMLElement>("[data-over]")
    if (overMark) overMark.hidden = vram <= currentRulerMax

    if (status === "can-run-slow" && vram > 0) {
      const split = currentUsable > 0 ? Math.min((currentUsable / vram) * 100, 100) : 50
      row.style.setProperty("--split", `${split}%`)
    } else {
      row.style.removeProperty("--split")
    }

    const vramVal = row.querySelector<HTMLElement>("[data-vram-val]")
    if (vramVal) vramVal.textContent = `${vram} GB`

    const tokEl = row.querySelector<HTMLElement>("[data-tok-speed]")
    if (tokEl) {
      if (toks !== null && status !== "cannot-run") {
        tokEl.textContent = `${toks} t/s`
        tokEl.dataset.tok = String(toks)
      } else {
        tokEl.textContent = ""
        delete tokEl.dataset.tok
      }
    }

    const memEl = row.querySelector<HTMLElement>("[data-mem-pct]")
    if (memEl) {
      if (memPct !== null) {
        memEl.textContent =
          status === "can-run-slow" ? ` · ${memPct}% ↗ RAM` : ` · ${memPct}% mem`
        memEl.style.color =
          status === "can-run-slow"
            ? "var(--color-offload)"
            : memPct > 100
              ? "var(--color-cannot-run)"
              : memPct > 75
                ? "var(--color-maybe)"
                : "var(--color-can-run)"
      } else {
        memEl.textContent = ""
      }
    }

    row.querySelectorAll<HTMLElement>("[data-quant-btn]").forEach((btn, i) => {
      btn.classList.toggle("is-active", i === quantIndex)
    })
  }

  function updateAllRows(hw: HardwareInfo) {
    $$("[data-model-id]").forEach((row) => {
      const qi = parseInt(row.dataset.selectedQuant || "2")
      updateModelRow(row, hw, qi)
    })
    updateSummary()
    updateVerdict()
    sortAndAnimateRows()
  }

  function updateSummary() {
    const counts: Record<string, number> = {
      S: 0,
      A: 0,
      B: 0,
      C: 0,
      D: 0,
      F: 0,
    }
    $$("[data-model-id]").forEach((c) => {
      const g = c.dataset.grade || "?"
      if (g in counts) counts[g]++
    })
    for (const [grade, count] of Object.entries(counts)) {
      $("#count-" + grade.toLowerCase())!.textContent = String(count)
    }
    $("#summary-bar")!.classList.remove("invisible")
  }

  function updateVerdict() {
    let runnable = 0
    let offloaded = 0
    let total = 0
    $$("[data-model-id]").forEach((row) => {
      total++
      const status = row.dataset.status
      if (status === "can-run" || status === "tight") runnable++
      if (status === "can-run-slow") offloaded++
    })
    const countEl = $("#nd-count")
    const totalEl = $("#nd-total")
    const slowEl = $("#nd-count-slow")
    if (countEl) countEl.textContent = String(runnable)
    if (totalEl) totalEl.textContent = String(total)
    if (slowEl) {
      slowEl.textContent = offloaded
        ? `+${offloaded} ${I18N.verdictOffloadNote}`
        : ""
    }
  }

  let currentSort = "score"

  function sortAndAnimateRows() {
    const order: Record<string, number> = {
      "can-run": 0,
      tight: 1,
      "can-run-slow": 2,
      unknown: 3,
      "cannot-run": 4,
    }

    function sortComparator(a: HTMLElement, b: HTMLElement): number {
      const rowA = a.querySelector<HTMLElement>("[data-model-id]")!
      const rowB = b.querySelector<HTMLElement>("[data-model-id]")!

      switch (currentSort) {
        case "params-asc":
          return (
            parseFloat(rowA.dataset.params || "0") -
            parseFloat(rowB.dataset.params || "0")
          )
        case "params-desc":
          return (
            parseFloat(rowB.dataset.params || "0") -
            parseFloat(rowA.dataset.params || "0")
          )
        case "release": {
          const ra = rowA.dataset.release || ""
          const rb = rowB.dataset.release || ""
          return rb.localeCompare(ra)
        }
        case "context":
          return (
            parseInt(rowB.dataset.context || "0") -
            parseInt(rowA.dataset.context || "0")
          )
        case "toks": {
          const tokA = parseFloat(
            rowA.querySelector<HTMLElement>("[data-tok-speed]")?.dataset.tok ||
              "0",
          )
          const tokB = parseFloat(
            rowB.querySelector<HTMLElement>("[data-tok-speed]")?.dataset.tok ||
              "0",
          )
          return tokB - tokA
        }
        case "vram": {
          const qA = JSON.parse(rowA.dataset.quants || "[]")
          const qB = JSON.parse(rowB.dataset.quants || "[]")
          const vA =
            qA[parseInt(rowA.dataset.selectedQuant || "2")]?.vramGB || 0
          const vB =
            qB[parseInt(rowB.dataset.selectedQuant || "2")]?.vramGB || 0
          return vA - vB
        }
        case "downloads": {
          const dA = parseInt(rowA.dataset.downloads || "0")
          const dB = parseInt(rowB.dataset.downloads || "0")
          return dB - dA
        }
        default: {
          const sa = order[rowA.dataset.status || "unknown"] ?? 2
          const sb = order[rowB.dataset.status || "unknown"] ?? 2
          if (sa !== sb) return sa - sb
          const scoreA = parseInt(rowA.dataset.score || "0")
          const scoreB = parseInt(rowB.dataset.score || "0")
          if (scoreA !== scoreB) return scoreB - scoreA
          return (
            parseFloat(rowA.dataset.params || "0") -
            parseFloat(rowB.dataset.params || "0")
          )
        }
      }
    }

    let animIdx = 0
    for (const gridId of ["#models-grid", "#models-grid-rest"]) {
      const grid = $(gridId)
      if (!grid) continue
      const links = Array.from(grid.children) as HTMLElement[]
      links.sort(sortComparator)
      links.forEach((link) => {
        const row = link.querySelector<HTMLElement>("[data-model-id]")
        if (row) {
          row.style.animationDelay = `${animIdx * 25}ms`
          row.classList.add("fade-in")
        }
        grid.appendChild(link)
        animIdx++
      })
    }
  }

  // ── Filters ────────────────────────────────────────────────

  let activeStatusFilter = "all"
  let activeUseFilter = "all"
  let activeProviderFilter = "all"
  let activeLicenseFilter = "all"
  let searchQuery = ""

  function applyFilters() {
    const query = searchQuery.toLowerCase()
    let featuredVisible = 0
    let restVisible = 0

    $$("#models-grid > a, #models-grid-rest > a").forEach((link) => {
      const row = link.querySelector<HTMLElement>("[data-model-id]")
      if (!row) return
      const grade = row.dataset.grade || "?"
      const uses = row.dataset.uses || ""
      const provider = row.dataset.provider || ""
      const name = (row.dataset.modelName || "").toLowerCase()
      const isFeatured = row.dataset.featured === "true"
      const license = row.dataset.license || ""
      const isCommercial = row.dataset.commercial === "true"
      let show = true

      if (query && !name.includes(query)) show = false
      if (activeStatusFilter === "featured") {
        if (!isFeatured) show = false
      } else if (activeStatusFilter === "can-run") {
        if (!["S", "A", "B"].includes(grade)) show = false
      } else if (activeStatusFilter === "tight") {
        if (!["C", "D"].includes(grade)) show = false
      } else if (activeStatusFilter === "cannot-run") {
        if (grade !== "F") show = false
      }
      if (activeUseFilter !== "all" && !uses.includes(activeUseFilter))
        show = false
      if (activeProviderFilter !== "all" && provider !== activeProviderFilter)
        show = false
      if (activeLicenseFilter === "commercial" && !isCommercial) show = false
      else if (activeLicenseFilter === "non-commercial" && isCommercial)
        show = false
      else if (
        activeLicenseFilter !== "all" &&
        activeLicenseFilter !== "commercial" &&
        activeLicenseFilter !== "non-commercial" &&
        license !== activeLicenseFilter
      )
        show = false

      link.style.display = show ? "" : "none"
      if (show) {
        if (isFeatured) featuredVisible++
        else restVisible++
      }
    })

    const totalVisible = featuredVisible + restVisible
    const divider = $("#rest-divider")
    const featuredGrid = $("#models-grid")
    const restGrid = $("#models-grid-rest")
    const noResults = $("#no-results")

    if (divider)
      divider.style.display =
        featuredVisible === 0 || restVisible === 0 ? "none" : ""
    if (featuredGrid)
      featuredGrid.style.display = featuredVisible === 0 ? "none" : ""
    if (restGrid) restGrid.style.display = restVisible === 0 ? "none" : ""
    if (noResults) noResults.style.display = totalVisible === 0 ? "" : "none"
    noResults?.classList.toggle("hidden", totalVisible > 0)
  }

  function resetAllFilters() {
    const searchInput = $<HTMLInputElement>("#search-input")
    const statusSelect = $<HTMLSelectElement>("#filter-status")
    const useSelect = $<HTMLSelectElement>("#filter-use")
    const providerSelect = $<HTMLSelectElement>("#filter-provider")
    const licenseSelect = $<HTMLSelectElement>("#filter-license")

    searchQuery = ""
    activeStatusFilter = "all"
    activeUseFilter = "all"
    activeProviderFilter = "all"
    activeLicenseFilter = "all"

    if (searchInput) searchInput.value = ""
    if (statusSelect) statusSelect.value = "all"
    if (useSelect) useSelect.value = "all"
    if (providerSelect) providerSelect.value = "all"
    if (licenseSelect) licenseSelect.value = "all"

    applyFilters()
    syncFiltersToURL()
  }

  function setupFilters() {
    const statusSelect = $<HTMLSelectElement>("#filter-status")
    const useSelect = $<HTMLSelectElement>("#filter-use")
    const providerSelect = $<HTMLSelectElement>("#filter-provider")
    const licenseSelect = $<HTMLSelectElement>("#filter-license")
    const resetBtn = $("#reset-filters")

    statusSelect?.addEventListener("change", () => {
      activeStatusFilter = statusSelect.value
      applyFilters()
      syncFiltersToURL()
    })

    useSelect?.addEventListener("change", () => {
      activeUseFilter = useSelect.value
      applyFilters()
      syncFiltersToURL()
    })

    providerSelect?.addEventListener("change", () => {
      activeProviderFilter = providerSelect.value
      applyFilters()
      syncFiltersToURL()
    })

    licenseSelect?.addEventListener("change", () => {
      activeLicenseFilter = licenseSelect.value
      applyFilters()
      syncFiltersToURL()
    })

    resetBtn?.addEventListener("click", resetAllFilters)
  }

  // ── Quant Switching ────────────────────────────────────────

  function setupQuantButtons() {
    $$("[data-quant-btn]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault()
        e.stopPropagation()
        const row = btn.closest<HTMLElement>("[data-model-id]")
        if (!row || !currentHW) return
        const qi = parseInt(btn.dataset.quantBtn || "0")
        updateModelRow(row, currentHW, qi)
      })
    })
  }

  function setupLicenseLinks() {
    document.addEventListener("click", (e) => {
      const badge = (e.target as Element).closest<HTMLElement>(
        "[data-license-link]",
      )
      if (!badge) return
      e.preventDefault()
      e.stopPropagation()
      window.location.href = badge.dataset.licenseLink!
    })
  }

  // ── Init ───────────────────────────────────────────────────

  async function init() {
    detectedHW = await detectHardware()

    const main = document.getElementById("results")
    const urlDeviceKey = main?.dataset.deviceKey

    if (urlDeviceKey) {
      const deviceOverrides = getDeviceOverrides(urlDeviceKey)
      if (deviceOverrides) {
        const prev = getHardwareOverrides()
        if (prev.systemRAM !== undefined)
          deviceOverrides.systemRAM = prev.systemRAM
        saveHardwareOverrides(deviceOverrides)
      }
    }

    currentHW = applyOverrides(detectedHW)
    updateHardwarePanel(currentHW)
    updateAllRows(currentHW)
  }

  // ── Search ───────────────────────────────────────────────

  function setupSearch() {
    const input = $<HTMLInputElement>("#search-input")
    if (!input) return

    input.addEventListener("input", () => {
      searchQuery = input.value.trim()
      applyFilters()
      syncFiltersToURL()
    })

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "/" &&
        document.activeElement !== input &&
        !(document.activeElement instanceof HTMLInputElement) &&
        !(document.activeElement instanceof HTMLTextAreaElement) &&
        !(document.activeElement instanceof HTMLSelectElement)
      ) {
        e.preventDefault()
        input.focus()
      }
      if (e.key === "Escape" && document.activeElement === input) {
        input.blur()
      }
    })
  }

  // ── Sort ─────────────────────────────────────────────────

  function setupSort() {
    const select = $<HTMLSelectElement>("#sort-select")
    if (!select) return
    select.addEventListener("change", () => {
      currentSort = select.value
      sortAndAnimateRows()
      syncFiltersToURL()
    })
  }

  // ── Keyboard Navigation ─────────────────────────────────

  function setupKeyboardNav() {
    let focusedRowIndex = -1

    function getVisibleLinks(): HTMLElement[] {
      return $$("#models-grid > a, #models-grid-rest > a").filter(
        (link) => link.style.display !== "none",
      )
    }

    function focusRow(index: number) {
      const links = getVisibleLinks()
      if (index < 0 || index >= links.length) return
      focusedRowIndex = index
      links.forEach((link, i) => {
        const row = link.querySelector<HTMLElement>("[data-model-id]")
        if (row) {
          if (i === index) {
            row.classList.add("ring-1", "ring-accent/40")
            link.scrollIntoView({ block: "nearest", behavior: "smooth" })
          } else {
            row.classList.remove("ring-1", "ring-accent/40")
          }
        }
      })
    }

    function clearFocus() {
      focusedRowIndex = -1
      $$("[data-model-id]").forEach((row) => {
        row.classList.remove("ring-1", "ring-accent/40")
      })
    }

    document.addEventListener("keydown", (e) => {
      const active = document.activeElement
      if (
        active instanceof HTMLInputElement ||
        active instanceof HTMLTextAreaElement ||
        active instanceof HTMLSelectElement
      )
        return

      const links = getVisibleLinks()

      switch (e.key) {
        case "j":
          e.preventDefault()
          focusRow(Math.min(focusedRowIndex + 1, links.length - 1))
          break
        case "k":
          e.preventDefault()
          focusRow(Math.max(focusedRowIndex - 1, 0))
          break
        case "Enter":
          if (focusedRowIndex >= 0 && focusedRowIndex < links.length) {
            e.preventDefault()
            const link = links[focusedRowIndex] as HTMLAnchorElement
            if (link.href) window.location.href = link.href
          }
          break
        case "Escape":
          clearFocus()
          break
      }
    })
  }

  // ── Popstate (back/forward navigation) ─────────────────

  function setupPopstate() {
    window.addEventListener("popstate", () => {
      if (!$("#models-grid")) return

      readFiltersFromURL()
      applyFilters()

      const path = window.location.pathname
      const deviceMatch = path.match(/^\/device\/([^/]+)/)
      if (deviceMatch) {
        const key = slugToDeviceKey(deviceMatch[1])
        if (key && detectedHW) {
          const deviceOverrides = getDeviceOverrides(key)
          if (deviceOverrides) {
            saveHardwareOverrides(deviceOverrides)
            currentHW = applyOverrides(detectedHW, deviceOverrides)
            updateHardwarePanel(currentHW)
            updateAllRows(currentHW)
          }
        }
      } else if (detectedHW) {
        saveHardwareOverrides({})
        currentHW = { ...detectedHW }
        updateHardwarePanel(currentHW)
        updateAllRows(currentHW)
      }
    })
  }

  // ── Tok/s Hover Preview ────────────────────────────────

  let speedPreviewWired = false

  function setupSpeedPreview() {
    if (speedPreviewWired) return
    if (typeof window === "undefined") return
    if (!window.matchMedia("(hover: hover)").matches) return
    speedPreviewWired = true

    const CHARS_PER_TOKEN = 4

    let popup: HTMLElement | null = null
    let textEl: HTMLElement | null = null
    let rateEl: HTMLElement | null = null
    let tierEl: HTMLElement | null = null
    let caretEl: HTMLElement | null = null
    let rafId: number | null = null
    let activeTrigger: HTMLElement | null = null

    function tierFor(t: number): { label: string; color: string } {
      if (t >= 60) return { label: I18N.speedTiers.fast, color: "var(--color-can-run)" }
      if (t >= 30) return { label: I18N.speedTiers.smooth, color: "var(--color-can-run)" }
      if (t >= 15) return { label: I18N.speedTiers.ok, color: "var(--color-maybe)" }
      if (t >= 5) return { label: I18N.speedTiers.slow, color: "var(--color-maybe)" }
      return { label: I18N.speedTiers.painful, color: "var(--color-cannot-run)" }
    }

    function ensurePopup() {
      if (popup) return
      popup = document.createElement("div")
      popup.className = "speed-preview"
      popup.setAttribute("role", "tooltip")
      popup.setAttribute("aria-live", "polite")
      popup.innerHTML = `
        <div class="speed-preview-head">
          <span class="speed-preview-rate"></span>
          <span class="speed-preview-tier"></span>
        </div>
        <div class="speed-preview-body">
          <span class="speed-preview-text"></span><span class="speed-preview-caret">▍</span>
        </div>
      `
      document.body.appendChild(popup)
      textEl = popup.querySelector(".speed-preview-text")
      rateEl = popup.querySelector(".speed-preview-rate")
      tierEl = popup.querySelector(".speed-preview-tier")
      caretEl = popup.querySelector(".speed-preview-caret")
    }

    function position(trigger: HTMLElement) {
      if (!popup) return
      const margin = 8
      const rect = trigger.getBoundingClientRect()
      popup.style.left = "0px"
      popup.style.top = "0px"
      const popRect = popup.getBoundingClientRect()
      let left = rect.left + rect.width / 2 - popRect.width / 2
      left = Math.max(margin, Math.min(left, window.innerWidth - popRect.width - margin))
      let top = rect.top - popRect.height - margin
      if (top < margin) top = rect.bottom + margin
      popup.style.left = `${left}px`
      popup.style.top = `${top}px`
    }

    function show(trigger: HTMLElement) {
      const tok = parseFloat(trigger.dataset.tok || "")
      if (!Number.isFinite(tok) || tok <= 0) return
      activeTrigger = trigger
      ensurePopup()
      if (!popup || !textEl || !rateEl || !tierEl || !caretEl) return

      const t = tierFor(tok)
      rateEl.textContent = `≈ ${tok} tok/s`
      rateEl.style.color = t.color
      tierEl.textContent = t.label
      tierEl.style.color = t.color
      caretEl.style.color = t.color
      textEl.textContent = ""

      popup.classList.add("visible")
      position(trigger)
      requestAnimationFrame(() => {
        if (activeTrigger === trigger) position(trigger)
      })

      if (rafId) cancelAnimationFrame(rafId)
      const charsPerSec = Math.max(1, tok * CHARS_PER_TOKEN)
      const start = performance.now()
      const animate = (now: number) => {
        if (activeTrigger !== trigger || !textEl) return
        const elapsed = now - start
        const sample = I18N.speedSample
        const chars = Math.min(
          sample.length,
          Math.floor((elapsed / 1000) * charsPerSec),
        )
        textEl.textContent = sample.slice(0, chars)
        if (chars < sample.length) {
          rafId = requestAnimationFrame(animate)
        } else {
          rafId = null
          if (caretEl) caretEl.style.opacity = "0"
        }
      }
      caretEl.style.opacity = ""
      rafId = requestAnimationFrame(animate)
    }

    function hide() {
      if (rafId) {
        cancelAnimationFrame(rafId)
        rafId = null
      }
      activeTrigger = null
      if (popup) popup.classList.remove("visible")
    }

    document.addEventListener("mouseover", (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>(
        "[data-tok-speed][data-tok]",
      )
      if (trigger) show(trigger)
    })

    document.addEventListener("mouseout", (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>(
        "[data-tok-speed][data-tok]",
      )
      if (!trigger) return
      const related = e.relatedTarget as Element | null
      if (!trigger.contains(related)) hide()
    })

    document.addEventListener("focusin", (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>(
        "[data-tok-speed][data-tok]",
      )
      if (trigger) show(trigger)
    })

    document.addEventListener("focusout", (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>(
        "[data-tok-speed][data-tok]",
      )
      if (trigger) hide()
    })

    window.addEventListener("scroll", () => hide(), { passive: true })
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") hide()
    })
  }

  // ── Boot ───────────────────────────────────────────────

  document.addEventListener("astro:page-load", () => {
    if (!$("#models-grid")) return

    loadI18n()

    activeStatusFilter = "all"
    activeUseFilter = "all"
    activeProviderFilter = "all"
    activeLicenseFilter = "all"
    searchQuery = ""
    currentSort = "score"

    readFiltersFromURL()

    setupQuantButtons()
    setupFilters()
    setupSearch()
    setupSort()
    setupKeyboardNav()
    setupHardwareEditing()
    setupLicenseLinks()
    setupPopstate()
    setupSpeedPreview()
    applyFilters()
    init()
  })
</script>

