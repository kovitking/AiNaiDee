# build output
dist/
.vercel/

# scratch output from the data-refresh scripts (scripts/scrape-ollama.ts writes
# out/ollama_models.json). Nothing in src/ reads it — it is a working artifact.
out/

# vitest run state
test-results/

# generated types
.astro/

# dependencies
node_modules/

# logs
pnpm-debug.log*

# environment variables
.env
.env.production

# real deploy target (host/user) — never commit this, see scripts/deploy.sh
scripts/deploy.local.env

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.vercel
.env*.local

# local agent settings
.claude/settings.local.json

# Vendored agent skill bundle — local tooling, not part of the site. Kept on
# disk but out of the repo: it is reference material rather than repo policy,
# and deploy-to-vercel actively contradicts this fork's Docker/Node direction.
# (.claude/skills/* are symlinks into .agents/skills/*, so both go together.)
.agents/
# Ignore the vendored symlinks by content, not the directory itself, so this
# repo's own skills below can be re-included — git cannot un-ignore a file
# inside an excluded directory.
.claude/skills/*

# ...except skills written for this repo, which are real files and belong in it.
!.claude/skills/ainaidee-icons/

# rendered copy of docs/deploy-architecture.md — keep only the markdown source
docs/deploy-architecture.html

# lockfile for the vendored skill bundle above
skills-lock.json
