{
	# Imperva Incapsula (CWAF) terminates TLS for ainaidee.com and forwards to
	# this origin over plain HTTP at :8587 for every hostname (ainaidee.com,
	# www, blog) — confirmed 2026-08-01. Caddy's job here is Host-based routing
	# only, not certificates: auto_https off, no `email` directive, no ACME.
	auto_https off
}

:8587 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@blog_host host blog.ainaidee.com
	handle @blog_host {
		# blog.ainaidee.com is Ghost's own site now, full stop — kovit's call
		# 2026-09-17, deliberately accepting the duplicate-content risk this
		# creates against ainaidee.com/blog/[slug] (the Astro-rendered copy,
		# fetched from the same Ghost content API, still exists and is not
		# being removed by this change). See CLAUDE.md's Blog section.
		#
		# Previously this proxied to app:4321 with a /blog{uri} rewrite so
		# src/pages/blog/* could render Ghost's content inside the Astro site's
		# own dark theme; that whole path is gone. Ghost's default theme
		# (Casper, English, light) is what visitors see here now.
		#
		# Imperva terminates TLS and forwards plain HTTP, so X-Forwarded-Proto
		# must be forced to https for every request here, not just /ghost* —
		# otherwise Ghost marks its session cookie Secure-for-an-http-origin
		# and admin login silently fails with 403s. Edge protection for
		# /ghost* (Imperva Login Protect) lives on the Imperva side, not here.
		reverse_proxy ghost:2368 {
			header_up X-Forwarded-Proto https
		}
	}

	# ainaidee.com, www.ainaidee.com — unchanged behavior from phase 1.
	#
	# DO NOT add a `www -> apex` redirect here. Measured against production on
	# 2026-08-23: Imperva already redirects the naked domain to www with a bare
	# 308 (https://ainaidee.com/ -> https://www.ainaidee.com/, no origin
	# involved — the response carries no `via: Caddy`). A www -> apex redirect
	# at this origin would bounce straight back off that edge rule and loop the
	# whole site into ERR_TOO_MANY_REDIRECTS. www is the hostname visitors
	# actually land on; the canonical-hostname mismatch this creates is a
	# SITE_URL / Imperva question, not a Caddy one. See the SEO section of
	# CLAUDE.md.
	handle {
		# Ported from the old vercel.json: OG images are served as .jpg, so
		# keep the .png URLs alive for anything that already linked them.
		@og_png path_regexp og_png ^/og/(.+)\.png$
		redir @og_png /og/{re.og_png.1}.jpg permanent

		reverse_proxy app:4321
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
