# runai's source is excluded (node-llama-cpp drags in a native toolchain the
# website never uses) but its manifest must survive: the Dockerfile copies it so
# the workspace matches pnpm-lock.yaml, which --frozen-lockfile requires.
packages/runai/*
!packages/runai/package.json
dist
